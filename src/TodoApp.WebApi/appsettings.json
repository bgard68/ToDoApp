{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=todoapp.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Jwt": {
    "Issuer": "TodoApp",
    "Audience": "TodoAppClient",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "KeyVault": {
    "Uri": ""
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Global": {
      "PermitLimit": 200,
      "WindowSeconds": 60
    },
    "TrustForwardedFor": false
  },
  "Seed": {
    "DemoUser": false,
    "Email": "demo@todoapp.local",
    "Password": ""
  }
}
