<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Needed for IHttpContextAccessor in the current-user service. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
    <!-- Security override: pin the patched native SQLite (CVE-2025-6965 / NU1903).
         Overrides the vulnerable transitive SQLitePCLRaw.lib.e_sqlite3 2.1.11; the managed
         core stays at 2.1.11 (compatible with EF Core 10). Remove once Microsoft.Data.Sqlite
         ships a fixed dependency. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- Security override: pin the patched System.Security.Cryptography.Pkcs
         (GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7 - quadratic CPU exhaustion in
         SignedCms.CheckSignature and EnvelopedCms.Decode). Overrides the vulnerable 9.0.11
         that arrives transitively via Microsoft.EntityFrameworkCore.SqlServer 10.0.12 ->
         Microsoft.Data.SqlClient 6.1.6. Pinned on the 10.0.x line to match the net10.0
         target; 9.0.21 is the equivalent fix on the 9.0.x line. Remove once
         Microsoft.Data.SqlClient ships a fixed dependency. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TodoApp.Application\TodoApp.Application.csproj" />
    <ProjectReference Include="..\TodoApp.Domain\TodoApp.Domain.csproj" />
  </ItemGroup>

</Project>
