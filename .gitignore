# ---------- .NET / Visual Studio ----------
bin/
obj/
publish/
artifacts/
*.binlog
*.user
# Visual Studio publish profiles - can contain the App Service name and deploy credentials.
*.pubxml
*.pubxml.user
*.zip
PublishProfiles/
*.suo
*.rsuser
*.userosscache
*.sln.docstates

# ---------- Test & coverage output ----------
TestResults/
[Tt]est[Rr]esult*/
*.trx
coverage*.json
coverage*.xml
coverage*.info
*.coverage

# ---------- IDEs ----------
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ---------- Database (SQLite) ----------
*.db
*.db-shm
*.db-wal

# ---------- Node / React (Vite) frontend ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Env files - ignore ALL real/local env files; keep only the blank .env.example template
.env
.env.*
!.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- OS ----------
.DS_Store
Thumbs.db
azure-export/

# Claude Code: commit shared settings, ignore personal/local session state
.claude/*
!.claude/settings.json
.claude/settings.local.json

# ---------- Secrets & cloud config - never commit real values ----------
# Azure Connected Services / Visual Studio - can carry endpoints, keys, deploy creds
serviceDependencies.json
serviceDependencies.local.json
ServiceConfiguration.*.cscfg
ApplicationInsights.config
local.settings.json
*.publishsettings
azureauth.json
.azure/
# Environment-specific app config that tends to hold secrets
# (base appsettings.json and appsettings.Development.json stay tracked on purpose)
appsettings.*.json
!appsettings.Development.json
# .NET user secrets, if ever materialized into the repo
secrets.json
# Certificates / private keys
*.pfx
*.p12
*.pem
*.key
